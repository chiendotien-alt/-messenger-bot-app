# Copy file này thành .env.local rồi điền giá trị thật vào
# (KHÔNG commit file .env.local lên GitHub)

FB_PAGE_ACCESS_TOKEN=
FB_VERIFY_TOKEN=locnuoc_verify_2026
# ID của Facebook App (Meta for Developers → App Settings → Basic → App ID) — để phân biệt tin bot gửi với tin gửi từ điện thoại
FB_APP_ID=
GOOGLE_API_KEY=
ADMIN_USER=admin
ADMIN_PASSWORD=

# Neon Postgres — tự thêm khi kết nối Neon trong Vercel → Storage
DATABASE_URL=

# (Không bắt buộc) Khách mới nhắn tin đầu → chờ bao nhiêu mili giây (tính từ tin đầu tiên) rồi mới gửi ảnh mẫu + câu mở đầu; tin khách gõ trong lúc chờ bị bỏ qua (mặc định 12000, đặt 0 để tắt)
FIRST_CONTACT_WAIT_MS=12000
# (Không bắt buộc) Chốt an toàn ngay sau khi bắt đầu gửi câu mở đầu: bỏ qua tin khách gõ thêm trong bao nhiêu mili giây (mặc định 5000, đặt 0 để tắt)
OPENING_BURST_MS=5000
# (Không bắt buộc) Khách mới chưa rõ hỏi sản phẩm nào → vẫn gửi ảnh mẫu + câu mở đầu của sản phẩm đầu tiên có câu mở đầu (mặc định bật, đặt 0 để tắt)
FIRST_CONTACT_DEFAULT_OPENING=1

# ---- Chống AI chập chờn / giảm độ trễ (không bắt buộc) ----
# Mỗi lần gọi Gemini chờ tối đa bao nhiêu mili giây (mặc định 12000)
GEMINI_TIMEOUT_MS=12000
# Chưa có kết quả sau ngần này mili giây → bắn thêm 1 yêu cầu sang model khác chạy song song (mặc định 4500)
GEMINI_HEDGE_MS=4500
# Tổng thời gian tối đa dành cho AI trong 1 tin nhắn (mặc định 30000)
REPLY_BUDGET_MS=30000
